<?xml version="1.0" encoding="UTF-8"?>

<suite name="cam5" version="1.0">
  <!--
      CAM5 PHYSICS SUITE (CAM5-MAM4 integration; "CAM5-ish")
      Deep convection         ZM
      Shallow convection      UW
      Macrophysics            Park
      Microphysics            PUMAS
          * note - original was MG1.
      Radiation               RRTMGP
          * note - original was RRTMG.
      Chemistry               MVP sulfur (DMS/SO2/H2SO4/H2O2/SOAE/SOAG)
                              + prescribed oxidants + table photolysis
      Aerosols                MAM4 (microphysics cluster, wet/dry deposition,
                              emissions, aerosol optics)
      Vertical Diffusion      UW (Bretherton-Park)
        Orographic Stress     Beljaars
          * note - original was TMS but decided to skip port.
      Gravity Wave Drag       Orographic

      Scheme order follows CAM src/physics/cam/physpkg.F90 (tphysbc for
      physics_before_coupler, tphysac for physics_after_coupler), with
      cld_macmic_num_steps=1 (CAM5 default, no macmic subcycling).
      Deliberate deviation: the aerosol wet-size cluster
      (calcsize/calcdry/wateruptake) runs before radiation here instead of at
      the end of the after-coupler chemistry chain; radiation then uses wet
      sizes from the previous step's constituents, matching CAM's lagged
      dgnumwet/qaerwat pbuf.
  -->
  <group name="physics_before_coupler">
    <!-- Helper schemes to read all possible constituents from file and/or namelist -->
    <scheme>to_be_ccppized_temporary</scheme>
    <scheme>prescribe_radiative_gas_concentrations</scheme>
    <scheme>set_cloud_fraction_top</scheme>

    <!-- Register MAM aerosol species (interstitial + cloud-borne) as CCPP
         constituents. sulfur_chemistry (listed at its run position in the
         after-coupler chemistry chain) registers the six sulfur-cycle gases
         at the register stage; never also list sulfur_chemistry_stub. -->
    <scheme>mam_constituents</scheme>

    <!-- Register + prescribe the chemistry oxidants O3/OH/NO3/HO2 (oxid
         climatology); consumed by table_photolysis (O3 column) and
         sulfur_chemistry (kinetics) in the after-coupler chain -->
    <scheme>prescribed_oxidants</scheme>

    <!-- Init-only: mode metadata + species index maps -->
    <scheme>mam_mode_metadata</scheme>
    <!-- Init-only: chemistry vmr workspace membership -->
    <scheme>chem_vmr_metadata</scheme>
    <!-- Init-only: resolve gasaerexch indices + pcage tables -->
    <scheme>mam_gasaerexch_setup</scheme>

    <!-- Prescribed radiation ozone (constituent 'ozone', distinct from the
         chemistry oxidant 'O3') -->
    <scheme>prescribed_ozone</scheme>

    <!-- Prescribed stratospheric aerosol (radiation); needs tropopause.
         Mutually exclusive with prescribed_volcanic_aerosol and
         modal_strat_sulfate. -->
    <scheme>tropopause_find</scheme>
    <scheme>prescribed_stratospheric_aerosol</scheme>

    <!-- INITIALIZE ZM NAMELIST (init phase only) -->
    <scheme>zm_conv_options</scheme>

    <!-- INITIALIZE CLOUD FRACTION NAMELIST (init phase only) -->
    <scheme>cloud_fraction_options</scheme>

    <!-- Initialize cloud fraction for two-moment microphysics (init phase only) -->
    <scheme>compute_cloud_fraction_two_moment</scheme>

    <!-- Compute global means of physics input and output total energy -->
    <scheme>check_energy_gmean</scheme>
    <!-- After gmean, output global mean energy diagnostics -->
    <scheme>check_energy_gmean_diagnostics</scheme>

    <!-- Add global mean energy difference as heating (diff between gmean and save_teout) -->
    <scheme>check_energy_zero_fluxes</scheme>
    <scheme>check_energy_fix</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>geopotential_temp</scheme>

    <!-- Check that energy and water change matches the boundary fluxes -->
    <scheme>check_energy_scaling</scheme>
    <scheme>check_energy_chng</scheme>

    <!-- Dry Adiabatic Adjustment -->
    <scheme>dadadj</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>

    <!-- Zhang McFarlane (convect_deep) -->
    <scheme>check_energy_zero_fluxes</scheme>
    <scheme>zm_convr</scheme>
    <scheme>zm_convr_tendency_diagnostics</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>
    <scheme>cloud_fraction_fice</scheme>
    <scheme>set_deep_conv_fluxes_to_general</scheme>
    <scheme>zm_conv_evap</scheme>
    <scheme>set_general_conv_fluxes_to_deep</scheme>
    <scheme>zm_evap_tendency_diagnostics</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>
    <scheme>cloud_fraction_fice</scheme>
    <scheme>zm_conv_momtran</scheme>
    <scheme>zm_momtran_tendency_diagnostics</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>apply_tendency_of_eastward_wind</scheme>
    <scheme>apply_tendency_of_northward_wind</scheme>
    <scheme>geopotential_temp</scheme>
    <scheme>zm_conv_convtran</scheme>
    <scheme>zm_tendency_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>
    <scheme>zm_diagnostics</scheme>

    <!-- Check that energy and water change matches the boundary fluxes -->
    <scheme>check_energy_scaling</scheme>
    <scheme>check_energy_chng</scheme>

    <!--
      University of Washington shallow convection. (uwshcu)
    -->

    <!-- Initialize diagnostics (has init phase only) -->
    <scheme>convect_shallow_diagnostics</scheme>

    <!-- Shallow convection: UW scheme -->
    <scheme>check_energy_zero_fluxes</scheme>
    <scheme>uw_convect_shallow</scheme>
    <scheme>uw_convect_shallow_diagnostics</scheme>
    <scheme>convect_shallow_diagnostics_after_shallow_scheme</scheme>
    <scheme>apply_tendency_of_northward_wind</scheme>
    <scheme>apply_tendency_of_eastward_wind</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <!-- clamps num* tendencies to fall within [1e-12,1e10] range.
         this replicates the physics_data.F90 behavior in CAM that skips qneg
         for number concentrations. -->
    <scheme>clamp_number_concentrations</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>

    <!-- Diagnostic quantity updates for shallow convection -->
    <!-- sum deep convective quantities with shallow including total convective rainout -->
    <scheme>convect_shallow_sum_to_deep</scheme>
    <scheme>convect_shallow_diagnostics_after_sum_to_deep</scheme>

    <!-- Check that energy and water change matches the boundary fluxes -->
    <scheme>check_energy_scaling</scheme>
    <scheme>check_energy_chng</scheme>

    <!--
      Park macrophysics (macrop_driver/cldwat2m_macro).
      Order from test/test_suites/suite_park_macro.xml. Energy checker
      around detrain/macro deferred (see that suite's TODO).
    -->

    <!-- Park macro 1: detrainment of convective condensate.
         NUMLIQ operator-split: the detrainment droplet-number tendency is
         deliberately NOT applied here (dedicated standard name skipped by
         the updater); park_macrophysics_run emits the combined
         detrain+macro number tendency to avoid cancellation at cloud
         edges. -->
    <scheme>park_macrophysics_detrain</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>clamp_number_concentrations</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>

    <!-- Cloud fractions from the post-detrain state -->
    <scheme>convective_cloud_cover</scheme>
    <scheme>convective_cloud_cover_diagnostics</scheme>
    <scheme>compute_cloud_fraction</scheme>
    <scheme>compute_cloud_fraction_diagnostics</scheme>
    <scheme>cloud_fraction_fice</scheme>

    <!-- Park macro 2: stratiform liquid/ice macrophysics (mmacro_pcond) -->
    <scheme>park_macrophysics</scheme>
    <scheme>park_macrophysics_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>clamp_number_concentrations</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>

    <!-- Save equilibrium state for the next timestep -->
    <scheme>park_macrophysics_save_qtlcwat</scheme>

    <!--
      microp_aero, MAM variant: aerosol bindings for cloud microphysics
      (naai/npccn/nacon/rndst producers for PUMAS).
      Order from test/test_suites/suite_microp_aero_mam.xml; hetfrz is NOT
      ported, the stub carries use_hetfrz_classnuc=.false. (D-HC2).
    -->
    <scheme>tropopause_find</scheme>
    <!-- CAM5: subgrid vertical velocity from UW PBL tke (previous step's,
         matching CAM's pbuf lag; the CLUBB/wp2 variant is for cam6/cam7) -->
    <scheme>compute_subgrid_vertical_velocity_tke</scheme>
    <scheme>scale_subgrid_vertical_velocity</scheme>
    <scheme>scale_subgrid_vertical_velocity_diagnostics</scheme>

    <!-- Default dust size radii for contact freezing (bins 1-4);
         contact_freezing_modal overwrites bin 3 below -->
    <scheme>dust_default_radii</scheme>

    <!-- Ice nucleation; constituent tendencies (preexisting-ice transfer)
         applied before droplet activation, mirroring CAM state1 -->
    <scheme>nucleate_ice_ccpp</scheme>
    <scheme>nucleate_ice_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>

    <!-- Droplet activation and mixing (ndrop dropmixnuc, modal) -->
    <scheme>droplet_activation_ccpp</scheme><!-- dropsonde:portable=dropmixnuc -->
    <scheme>droplet_activation_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>

    <!-- Contact freezing dust inputs from coarse-mode dust (post-activation
         aerosol state, CAM order) -->
    <scheme>contact_freezing_modal</scheme>

    <!-- Carries use_hetfrz_classnuc to nucleate_ice and PUMAS -->
    <scheme>hetfrz_classnuc_stub</scheme>

    <!-- CLDO stamp: save current stratiform cloud fraction for next step's
         droplet activation; must run BEFORE the PUMAS schemes (dims_post
         rewrites the cloud fraction) -->
    <scheme>stratiform_cloud_fraction_save</scheme>

    <!--
      PUMAS stratiform cloud microphysics.
      Order from test/test_suites/suite_pumas.xml.
    -->
    <scheme>pumas_pre_main</scheme>
    <scheme>micro_pumas_ccpp_dimensions_pre</scheme>
    <scheme>micro_pumas_ccpp</scheme>
    <scheme>micro_pumas_ccpp_dimensions_post</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>clamp_number_concentrations</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>geopotential_temp</scheme>
    <!-- Post PUMAS for REI - needs updated numice, numliq -->
    <scheme>pumas_post_main</scheme>
    <!-- Convective size-distribution parameters where the stratiform cloud
         fraction is negligible (CAM micro_pumas_cam limiter) -->
    <scheme>micro_pumas_ccpp_optics_limiter</scheme>

    <!--
      Aerosol wet deposition: convective processing (aero_convproc) +
      stratiform scavenging (wetdepa_v2), then surface coupling.
      CAM tphysbc: aero_model_wetdep after the microphysics, before
      cloud_diagnostics_calc/radiation. convproc_do_aer=.true. (D-HC5).
      Order from test/test_suites/suite_mam_wetdep.xml.
    -->
    <scheme>aero_convproc_ccpp</scheme><!-- dropsonde:portable=aero_convproc_run -->
    <!-- Placement load-bearing: SFWETC is aerdepwetis at convproc exit -->
    <scheme>aero_convproc_diagnostics</scheme>
    <scheme>aero_wetdep_ccpp</scheme><!-- dropsonde:portable=wetdepa_v2 -->
    <scheme>aero_wetdep_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <scheme>aero_deposition_setwet_ccpp</scheme>

    <!--
      Aerosol wet size for radiation: calcsize + calcdry + wateruptake
      (suite_modal_aero_wet order). See the header note on the deliberate
      placement deviation from CAM.
    -->
    <scheme>modal_aero_calcsize_ccpp</scheme><!-- dropsonde:portable=modal_aero_calcsize_run -->
    <scheme>modal_aero_calcsize_diagnostics</scheme>
    <scheme>modal_aero_calcdry_ccpp</scheme><!-- dropsonde:portable=modal_aero_calcdry_run -->
    <scheme>modal_aero_wateruptake_ccpp</scheme><!-- dropsonde:portable=modal_aero_wateruptake_sub -->
    <scheme>modal_aero_wateruptake_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>

    <!--
      Radiation cloud-water inputs (CAM cloud_diagnostics_calc two-moment
      water paths + conv_water_4rad), immediately before radiation as in
      CAM tphysbc.
    -->
    <scheme>convective_cloud_water</scheme>
    <scheme>cloud_water_paths</scheme>

    <!-- State diagnostics -->
    <scheme>sima_state_diagnostics</scheme>

    <!-- Radiation (RRTMGP) -->
    <scheme>rrtmgp_pre</scheme>
    <!-- Aerosol optical properties (modal instances via wet size/water
         from the cluster above); rrtmgp_pre precedes for night columns -->
    <scheme>aerosol_optics</scheme>
    <scheme>aerosol_optics_diagnostics</scheme>
    <scheme>rrtmgp_cloud_optics_setup</scheme>
    <scheme>tropopause_find</scheme>
    <scheme>rrtmgp_variables</scheme>
    <scheme>rrtmgp_inputs</scheme>
    <scheme>rrtmgp_sw_cloud_optics</scheme>
    <scheme>rrtmgp_sw_mcica_subcol_gen</scheme>
    <scheme>rrtmgp_cloud_diagnostics</scheme>
    <!-- Shortwave subcycle - last iteration is climate calculation -->
    <subcycle loop="number_of_diagnostic_subcycles">
      <scheme>rrtmgp_constituents</scheme>
      <scheme>rrtmgp_sw_gas_optics_pre</scheme>
      <scheme>rrtmgp_sw_gas_optics</scheme>
      <scheme>solar_irradiance_data</scheme>
      <scheme>rrtmgp_sw_solar_var</scheme>
      <scheme>rrtmgp_sw_aerosols</scheme>
      <scheme>rrtmgp_sw_rte</scheme>
      <scheme>rrtmgp_sw_calculate_fluxes</scheme>
      <scheme>rrtmgp_sw_calculate_heating_rate</scheme>
      <scheme>rrtmgp_sw_diagnostics</scheme>
      <scheme>rrtmgp_subcycle</scheme>
    </subcycle>
    <scheme>rrtmgp_lw_cloud_optics</scheme>
    <scheme>rrtmgp_lw_mcica_subcol_gen</scheme>
    <!-- Longwave subcycle - last iteration is climate calculation-->
    <subcycle loop="number_of_diagnostic_subcycles">
      <scheme>rrtmgp_constituents</scheme>
      <scheme>rrtmgp_lw_gas_optics_pre</scheme>
      <scheme>rrtmgp_lw_gas_optics</scheme>
      <scheme>rrtmgp_lw_aerosols</scheme>
      <scheme>rrtmgp_lw_rte</scheme>
      <scheme>rrtmgp_lw_calculate_fluxes</scheme>
      <scheme>rrtmgp_lw_calculate_heating_rate</scheme>
      <scheme>rrtmgp_lw_diagnostics</scheme>
      <scheme>rrtmgp_subcycle</scheme>
    </subcycle>
    <!-- End longwave subcycle -->
    <scheme>rrtmgp_inputs_setup</scheme>
    <scheme>rrtmgp_sw_solar_var_setup</scheme>
    <scheme>rrtmgp_dry_static_energy_tendency</scheme>
    <scheme>calculate_net_heating</scheme>
    <scheme>rrtmgp_post</scheme>
    <scheme>rrtmgp_diagnostics</scheme>
    <!-- State updaters -->
    <scheme>apply_heating_rate</scheme>
    <scheme>geopotential_temp</scheme>
    <!-- end Radiation (RRTMGP) -->

    <!-- Find tropopause -->
    <!-- Tropopause find has to make history output at the end of convective adjustment -->
    <!-- so supersaturated cells are not written to the tape. -->
    <scheme>tropopause_find</scheme>
    <scheme>tropopause_diagnostics</scheme>

    <!-- Calculate surface variables -->
    <!-- This must be done at the end
         of the "before_coupler" group. -->
    <scheme>calc_dry_air_ideal_gas_density</scheme>
    <scheme>set_surface_coupling_vars</scheme>

  </group>

  <group name="physics_after_coupler">

    <!--
      Chemistry and aerosols.
      CAM tphysac order: chem_emissions -> chem_timestep_tend (gas-phase
      chemistry + aerosol microphysics cluster) -> vertical diffusion ->
      aero_model_drydep -> gravity wave drag.
    -->

    <!-- Chemical tropopause for the chemistry chain (strat sulfate region) -->
    <scheme>tropopause_find</scheme>

    <!--
      Emissions (CAM chem_emissions order; suite_chem_file_emissions).
      chem_cflx_zero zeroes every mechanism cflx row first; providers below
      overwrite or accumulate. Gas cflx rows are applied by vertical
      diffusion; aerosol rows by dropmixnuc_apply_surface_fluxes (in the
      vdiff chain below). srf_emis_specifier / ext_frc_specifier /
      megan fields are set per case in user_nl_cam (no defaults).
    -->
    <scheme>chem_cflx_zero</scheme>
    <!-- Dust + seasalt (CAM aero_model_emissions) -->
    <scheme>aero_emissions_ccpp</scheme>
    <scheme>aero_emissions_diagnostics</scheme>
    <!-- MEGAN coupler VOC fluxes -> SOAE cflx; its init must precede
         chem_srf_emissions_init (SF-field union) -->
    <scheme>chem_megan_emissions</scheme>
    <scheme>chem_srf_emissions</scheme>
    <!-- Elevated emissions -> constituent tendencies, applied immediately -->
    <scheme>chem_extfrc</scheme>
    <scheme>apply_constituent_tendencies</scheme>

    <!--
      Gas-phase sulfur chemistry + MAM4 microphysics cluster
      (suite_mam_sulfur_chemistry production shape, method A), plus
      chem_vmr_fill_invariants: refresh the O3/HO2 invariant vmr slots from
      the prescribed-oxidant constituents each step (required for dycore
      runs; snapshot suites read them from tape instead).
    -->
    <scheme>mam_mean_mass</scheme>
    <scheme>table_photolysis</scheme>
    <scheme>sulfur_chemistry</scheme>
    <scheme>mam_vmr_pack</scheme>
    <scheme>chem_vmr_fill_invariants</scheme>
    <scheme>mam_vmr_checkpoint_entry</scheme>
    <scheme>modal_aero_setsox_ccpp</scheme><!-- dropsonde:portable=setsox_sub -->
    <scheme>mam_setsox_tendency</scheme>
    <scheme>modal_aero_gasaerexch</scheme>
    <scheme>modal_aero_rename_ccpp</scheme><!-- dropsonde:portable=modal_aero_rename_run -->
    <scheme>mam_vmr_apply</scheme>
    <scheme>modal_aero_newnuc_ccpp</scheme><!-- dropsonde:portable=modal_aero_newnuc_run -->
    <scheme>mam_vmr_checkpoint_postnewnuc</scheme>
    <scheme>modal_aero_coag_ccpp</scheme><!-- dropsonde:portable=modal_aero_coag_run -->
    <scheme>mam_vmr_checkpoint_postcoag</scheme>
    <scheme>mam_vmr_unpack</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <!-- note: intentionally no qneg (matches the certification suites) -->

    <!--
      Orographic form drag: Beljaars SGO
    -->
    <scheme>beljaars_drag</scheme>
    <scheme>beljaars_drag_diagnostics</scheme>

    <!--
      Vertical diffusion (UW/Bretherton-Park; formerly diag_TKE)
    -->

    <!-- read namelist options -->
    <scheme>vertical_diffusion_options</scheme>

    <!-- stub: zero UBC -->
    <scheme>zero_upper_boundary_condition</scheme>

    <!-- init phase only: for setting vertical diffusion top -->
    <scheme>hb_diff_set_vertical_diffusion_top</scheme>

    <!-- vdiff pre-interstitial 0: create p coords1d and potential temp. -->
    <scheme>vertical_diffusion_prepare_inputs</scheme>

    <!-- vdiff pre-interstitial 1: copy surface fluxes from coupler (cam_in)
         wsx and wsy from coupler are needed for implicit surface stress
         calculations later on in the diffusion solver. -->
    <scheme>hb_diff_prepare_vertical_diffusion_inputs</scheme>

    <!-- vdiff pre-interstitial 2: interpolate t, rho, p to interfaces -->
    <!-- not in WACCM-X mode so do not use rairv in vdiff. -->
    <scheme>vertical_diffusion_not_use_rairv</scheme>
    <scheme>vertical_diffusion_set_temperature_at_toa_default</scheme>
    <scheme>vertical_diffusion_interpolate_to_interfaces</scheme>

    <!-- vdiff pre-interstitial 3: calculate total surface stresses
         used for surface momentum flux diagnostic. -->
    <scheme>vertical_diffusion_set_total_surface_stress</scheme>

    <!-- UW eddy diffusivity scheme -->
    <scheme>bretherton_park_diff</scheme>
    <scheme>bretherton_park_diff_diagnostics</scheme>
    <scheme>compute_kinematic_fluxes_and_obklen</scheme>
    <scheme>eddy_diffusivity_adjustment_above_pbl</scheme>

    <!-- sponge layer vertical diffusion (mutate kvm) -->
    <scheme>vertical_diffusion_sponge_layer</scheme>

    <!-- diagnostics -->

    <!-- vdiff pre-interstitial 4: calculate drag coefficient -->
    <scheme>implicit_surface_stress_add_drag_coefficient</scheme>
    <scheme>turbulent_mountain_stress_add_drag_coefficient</scheme>

    <!-- vdiff pre-interstitial 5: calculate damping rate from drag coef. -->
    <scheme>vertical_diffusion_wind_damping_rate</scheme>
    <scheme>beljaars_add_wind_damping_rate</scheme>

    <!-- vdiff compute 1: horizontal momentum diffusion; dissipate KE -->
    <!-- note: vdiff compute schemes calculate "provisional" updates,
         but these updates are not applied as physics tendencies until the end. -->
    <scheme>vertical_diffusion_diffuse_horizontal_momentum</scheme>

    <!-- set dry static energy top boundary condition to zero.
         zero is used for: no molecular diffusion, or molecular diffusion + WACCM-X is active.
         otherwise, use vertical_diffusion_set_dry_static_energy_at_toa_molecdiff -->
    <scheme>vertical_diffusion_set_dry_static_energy_at_toa_zero</scheme>

    <!-- vdiff compute 2: dry static energy diffusion -->
    <scheme>vertical_diffusion_diffuse_dry_static_energy</scheme>

    <!-- vdiff compute 3: tracer diffusion -->
    <scheme>vertical_diffusion_diffuse_tracers</scheme>

    <!-- vdiff post-interstitial 0: for non-diffused tracers, apply constituent flux.
         this is necessary for tracers handled by ndrop activation vertical mixing,
         i.e., modal aerosol species. -->
    <scheme>dropmixnuc_apply_surface_fluxes</scheme>

    <!-- vdiff post-interstitial 1: convert provisional updates to tendencies -->
    <scheme>vertical_diffusion_tendencies</scheme>

    <!-- diagnostics need to be outputted before tendencies are applied. -->
    <scheme>vertical_diffusion_tendencies_diagnostics</scheme>

    <!-- apply tendencies from vdiff -->
    <scheme>apply_tendency_of_northward_wind</scheme>
    <scheme>apply_tendency_of_eastward_wind</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>
    <scheme>update_dry_static_energy</scheme>

    <!--
      Aerosol dry deposition + surface coupling
      (CAM tphysac: aero_model_drydep runs AFTER vertical diffusion).
      Order from test/test_suites/suite_mam_drydep.xml.
    -->
    <scheme>aero_drydep_ccpp</scheme><!-- dropsonde:portable=dust_sediment_tend -->
    <scheme>aero_drydep_diagnostics</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <scheme>aero_deposition_setdry_ccpp</scheme>

    <!--
      Gravity wave drag.
    -->

    <!-- Initialize all gravity wave parameterizations and read namelist -->
    <scheme>gravity_wave_drag_common</scheme>

    <!-- Interstitial: Prepare vertical profiles and accumulated quantities -->
    <scheme>check_energy_zero_fluxes</scheme>
    <scheme>gravity_wave_drag_prepare_profiles</scheme>

    <!-- Prepare vertical ramp coefficients to taper drag at top of model -->
    <scheme>gravity_wave_drag_top_taper</scheme>

    <!-- Orographic gravity wave drag -->
    <scheme>gravity_wave_drag_orographic</scheme>

    <!-- Interstitial: Convert tendencies for dry constituents to dry air basis -->
    <scheme>convert_dry_constituent_tendencies_to_dry_air_basis</scheme>

    <!-- Diagnostic output for common gravity wave drag -->
    <scheme>gravity_wave_drag_common_diagnostics</scheme>

    <!-- Apply tendencies from gravity wave parameterizations -->
    <scheme>apply_tendency_of_eastward_wind</scheme>
    <scheme>apply_tendency_of_northward_wind</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <scheme>apply_heating_rate</scheme>
    <scheme>qneg</scheme>
    <scheme>geopotential_temp</scheme>
    <scheme>update_dry_static_energy</scheme>

    <!-- Check energy -->
    <scheme>check_energy_scaling</scheme>
    <scheme>check_energy_chng</scheme>

    <!--
      Energy conservation/budget checks.
    -->

    <!-- Save current total energy from dycore for energy fixer in time step. Total energy in current state is updated by the last check_energy_chng call. -->
    <scheme>check_energy_save_teout</scheme>

    <!-- Dry Mass and Energy adjust -->
    <!-- COMMENTED OUT until qini/liqini/iceini have initialization routines -->
    <!-- See https://github.com/ESCOMP/atmospheric_physics/issues/222 -->
    <!-- <scheme>dme_adjust</scheme> -->

