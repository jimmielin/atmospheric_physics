[ccpp-table-properties]
  name = aero_convproc_ccpp
  type = scheme
  dependencies = ../aero_convproc.F90,../aero_activate.F90,mam_mode_metadata.F90

[ccpp-arg-table]
  name = aero_convproc_ccpp_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ mwh2o ]
  standard_name = molecular_weight_of_h2o
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ r_universal ]
  standard_name = universal_gas_constant
  units = J K-1 kmol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rhoh2o ]
  standard_name = fresh_liquid_water_density_at_0c
  units = kg m-3
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ convproc_do_aer ]
  standard_name = do_convective_processing_of_aerosols
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = aero_convproc_ccpp_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ dt ]
  standard_name = timestep_for_physics
  units = s
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ temp ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdeldry ]
  standard_name = air_pressure_thickness_of_dry_air
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dp_frac ]
  standard_name = deep_convective_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ icwmrdp ]
  standard_name = in_cloud_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_deep_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ rprddp ]
  standard_name = tendency_of_precipitation_wrt_moist_air_and_condensed_water_due_to_deep_convection_excluding_subcloud_evaporation
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ nevapr_dpcu ]
  standard_name = precipitation_evaporation_due_to_deep_convection
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zm_du ]
  standard_name = atmosphere_detrainment_convective_mass_flux_for_deep_convection_for_convective_columns
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zm_eu ]
  standard_name = atmosphere_updraft_entrainment_convective_mass_flux_for_deep_convection_for_convective_columns
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zm_ed ]
  standard_name = atmosphere_downdraft_entrainment_convective_mass_flux_for_deep_convection_for_convective_columns
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zm_dp ]
  standard_name = pressure_thickness_for_deep_convection_for_convective_columns
  units = hPa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zm_jt ]
  standard_name = vertical_index_at_top_of_deep_convection_for_convective_columns_real
  units = index
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ zm_maxg ]
  standard_name = vertical_index_of_deep_convection_launch_level_for_convective_columns_real
  units = index
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ zm_ideep ]
  standard_name = horizontal_index_of_convective_columns_for_deep_convection_for_convective_columns_real
  units = index
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ const ]
  standard_name = ccpp_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ const_tend ]
  standard_name = ccpp_constituent_tendencies
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ aerdepwetis ]
  standard_name = surface_wet_deposition_flux_of_interstitial_aerosol_constituents
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = out
[ qsrflx_incloud ]
  standard_name = surface_wet_deposition_flux_of_interstitial_aerosol_constituents_due_to_in_cloud_removal_in_convective_cloud_processing
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = out
[ qsrflx_evapres ]
  standard_name = surface_wet_deposition_flux_of_interstitial_aerosol_constituents_due_to_precipitation_evaporation_in_convective_cloud_processing
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = out
[ conu ]
  standard_name = updraft_mixing_ratio_of_aerosol_constituents_in_convective_cloud_processing
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = out
[ dcondt_wetdep ]
  standard_name = tendency_of_aerosol_constituents_due_to_wet_removal_in_convective_cloud_processing
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = out
[ dcondt_resusp ]
  standard_name = tendency_of_aerosol_constituents_due_to_precipitation_evaporation_resuspension_in_convective_cloud_processing
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = out
[ mfup_max ]
  standard_name = maximum_column_updraft_mass_flux_due_to_deep_convection
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = out
[ wcldbase ]
  standard_name = cloud_base_vertical_velocity_due_to_deep_convection
  units = m s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = out
[ kcldbase ]
  standard_name = vertical_index_at_cloud_base_for_deep_convection_real
  units = index
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = out
[ convproc_do_aer ]
  standard_name = do_convective_processing_of_aerosols
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ convproc_do_deep ]
  standard_name = do_deep_convection_in_aerosol_convective_processing
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ convproc_do_evaprain_atonce ]
  standard_name = do_evaporated_rain_resuspension_at_once_in_aerosol_convective_processing
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ convproc_pom_spechygro ]
  standard_name = hygroscopicity_of_primary_organic_matter_for_aerosol_convective_processing
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rhoh2o ]
  standard_name = fresh_liquid_water_density_at_0c
  units = kg m-3
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rh2o ]
  standard_name = gas_constant_of_water_vapor
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ latvap ]
  standard_name = latent_heat_of_vaporization_of_water_at_0c
  units = J kg-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ cpair ]
  standard_name = specific_heat_of_dry_air_at_constant_pressure
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rair ]
  standard_name = gas_constant_of_dry_air
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
