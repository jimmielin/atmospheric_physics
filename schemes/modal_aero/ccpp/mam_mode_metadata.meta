[ccpp-table-properties]
  name = mam_mode_metadata
  type = scheme

[ccpp-arg-table]
  name = mam_mode_metadata_init
  type = scheme
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
