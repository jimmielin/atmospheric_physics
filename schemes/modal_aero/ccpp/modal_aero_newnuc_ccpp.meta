[ccpp-table-properties]
  name = modal_aero_newnuc_ccpp
  type = scheme
  dependencies = ../modal_aero_newnuc.F90,mam_mode_metadata.F90,../../../to_be_ccppized/wv_saturation.F90

[ccpp-arg-table]
  name = modal_aero_newnuc_ccpp_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rgas ]
  standard_name = universal_gas_constant
  units = J K-1 kmol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ avogad ]
  standard_name = avogadro_number
  units = molecules kmol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ mwso4 ]
  standard_name = molecular_weight_of_so4
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ mwnh4 ]
  standard_name = molecular_weight_of_nh4
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = modal_aero_newnuc_ccpp_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ top_lev ]
  standard_name = index_of_air_pressure_at_top_of_aerosol_model
  units = index
  type = integer
  dimensions = ()
  intent = in
[ num_q ]
  standard_name = number_of_ccpp_constituents
  units = count
  type = integer
  dimensions = ()
  intent = in
[ loffset ]
  standard_name = mam_microphysics_constituent_index_offset
  units = count
  type = integer
  dimensions = ()
  intent = in
[ deltat ]
  standard_name = timestep_for_physics
  units = s
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zm ]
  standard_name = geopotential_height_wrt_surface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pblh ]
  standard_name = atmosphere_boundary_layer_thickness
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ qv ]
  standard_name = water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water
  advected = true
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ cld ]
  standard_name = cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratio_of_mam_microphysics_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ del_h2so4_gasprod ]
  standard_name = change_in_h2so4_molar_mixing_ratio_due_to_gas_phase_chemistry
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ del_h2so4_aeruptk ]
  standard_name = change_in_h2so4_molar_mixing_ratio_due_to_aerosol_uptake
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
