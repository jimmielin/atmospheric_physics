[ccpp-table-properties]
  name = modal_aero_coag_ccpp
  type = scheme
  dependencies = ../modal_aero_coag.F90,../modal_aero_gasaerexch.F90,mam_mode_metadata.F90

[ccpp-arg-table]
  name = modal_aero_coag_ccpp_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ rgas ]
  standard_name = universal_gas_constant
  units = J K-1 kmol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ pstd ]
  standard_name = us_standard_atmospheric_pressure_at_sea_level
  units = Pa
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ tmelt ]
  standard_name = freezing_point_of_water
  units = K
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ boltz ]
  standard_name = boltzmann_constant
  units = J K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = modal_aero_coag_ccpp_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ top_lev ]
  standard_name = index_of_air_pressure_at_top_of_aerosol_model
  units = index
  type = integer
  dimensions = ()
  intent = in
[ num_q ]
  standard_name = number_of_ccpp_constituents
  units = count
  type = integer
  dimensions = ()
  intent = in
[ loffset ]
  standard_name = mam_microphysics_constituent_index_offset
  units = count
  type = integer
  dimensions = ()
  intent = in
[ nstep ]
  standard_name = current_timestep_number
  units = count
  type = integer
  dimensions = ()
  intent = in
[ deltat ]
  standard_name = timestep_for_physics
  units = s
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratio_of_mam_microphysics_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ dgncur_a ]
  standard_name = dry_number_mode_diameter_of_modal_aerosol
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = in
[ dgncur_awet ]
  standard_name = wet_number_mode_diameter_of_modal_aerosol
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = in
[ wetdens_a ]
  standard_name = wet_density_of_modal_aerosol
  units = kg m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = in
[ dqdt_coag ]
  standard_name = tendency_of_mam_microphysics_constituents_due_to_coagulation
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
