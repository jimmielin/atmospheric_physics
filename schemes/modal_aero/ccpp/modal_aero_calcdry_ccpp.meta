[ccpp-table-properties]
  name = modal_aero_calcdry_ccpp
  type = scheme
  dependencies = ../modal_aero_calcsize.F90

[ccpp-arg-table]
  name = modal_aero_calcdry_ccpp_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ top_lev ]
  standard_name = index_of_air_pressure_at_top_of_aerosol_model
  units = index
  type = integer
  dimensions = ()
  intent = in
[ do_strat_sulfate ]
  standard_name = flag_for_stratospheric_sulfate_treatment
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ dgncur_a ]
  standard_name = dry_number_mode_diameter_of_modal_aerosol
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = in
[ hygro ]
  standard_name = volume_weighted_hygroscopicity_of_modal_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = out
[ dryvol ]
  standard_name = single_particle_dry_volume_of_modal_aerosol
  units = m3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = out
[ dryrad ]
  standard_name = dry_volume_mean_radius_of_modal_aerosol
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = out
[ drymass ]
  standard_name = single_particle_dry_mass_of_modal_aerosol
  units = kg
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = out
[ so4dryvol ]
  standard_name = single_particle_sulfate_dry_volume_of_modal_aerosol
  units = m3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = out
[ naer ]
  standard_name = aerosol_number_mixing_ratio_of_modal_aerosol
  units = kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
