[ccpp-table-properties]
  name = mam_vmr_inject_presetsox
  type = scheme
  dependencies = ../../chemistry/chem_vmr_metadata.F90

[ccpp-arg-table]
  name = mam_vmr_inject_presetsox_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ vmr_presetsox ]
  standard_name = molar_mixing_ratio_of_mam_microphysics_constituents_before_aqueous_sulfur_chemistry
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratio_of_mam_microphysics_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
