[ccpp-table-properties]
  name = mam_vmr_apply
  type = scheme
  dependencies = mam_gasaerexch_setup.F90

[ccpp-arg-table]
  name = mam_vmr_apply_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ num_q ]
  standard_name = number_of_ccpp_constituents
  units = count
  type = integer
  dimensions = ()
  intent = in
[ deltat ]
  standard_name = timestep_for_physics
  units = s
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ top_lev ]
  standard_name = vertical_layer_index_of_aerosol_model_top
  units = index
  type = integer
  dimensions = ()
  intent = in
[ dotend ]
  standard_name = flag_for_mam_microphysics_constituent_tendency
  units = flag
  type = logical
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ dqdt ]
  standard_name = tendency_of_molar_mixing_ratio_of_mam_microphysics_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratio_of_mam_microphysics_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ del_h2so4_aeruptk ]
  standard_name = change_in_h2so4_molar_mixing_ratio_due_to_aerosol_uptake
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
