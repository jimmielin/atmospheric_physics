[ccpp-table-properties]
  name = prescribed_stratospheric_aerosol
  type = scheme

[ccpp-arg-table]
  name  = prescribed_stratospheric_aerosol_register
  type  = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ prescribed_strataero_file ]
  standard_name = filename_of_prescribed_stratospheric_aerosol
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ prescribed_strataero_datapath ]
  standard_name = datapath_for_prescribed_stratospheric_aerosol
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ strataero_constituents ]
  standard_name = prescribed_stratospheric_aerosol_constituents
  units = none
  type = ccpp_constituent_properties_t
  allocatable = True
  dimensions = (:)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name  = prescribed_stratospheric_aerosol_init
  type  = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ prescribed_strataero_file ]
  standard_name = filename_of_prescribed_stratospheric_aerosol
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ prescribed_strataero_filelist ]
  standard_name = filename_of_file_list_for_prescribed_stratospheric_aerosol
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ prescribed_strataero_datapath ]
  standard_name = datapath_for_prescribed_stratospheric_aerosol
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ prescribed_strataero_type ]
  standard_name = time_interpolation_method_for_prescribed_stratospheric_aerosol
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ prescribed_strataero_cycle_yr ]
  standard_name = cycle_year_for_prescribed_stratospheric_aerosol
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ prescribed_strataero_fixed_ymd ]
  standard_name = fixed_date_for_prescribed_stratospheric_aerosol
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ prescribed_strataero_fixed_tod ]
  standard_name = fixed_time_of_day_for_prescribed_stratospheric_aerosol
  units = s
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name  = prescribed_stratospheric_aerosol_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pcnst ]
  standard_name = number_of_ccpp_constituents
  units = count
  type = integer
  dimensions = ()
  intent = in
[ mwdry ]
  standard_name = molecular_weight_of_dry_air
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ boltz ]
  standard_name = boltzmann_constant
  units = J K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ T ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmiddry ]
  standard_name = air_pressure_of_dry_air
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pint ]
  standard_name = air_pressure_at_interface
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ phis ]
  standard_name = surface_geopotential
  units = m2 s-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ zi ]
  standard_name = geopotential_height_wrt_surface_at_interface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ lat ]
  standard_name = latitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ tropLev_chem ]
  standard_name = tropopause_vertical_layer_index_from_chemical_method
  units = index
  type = integer
  dimensions = (horizontal_loop_extent)
  intent = in
[ prescribed_strataero_use_chemtrop ]
  standard_name = flag_for_chemistry_tropopause_for_prescribed_stratospheric_aerosol
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ constituents ]
  standard_name = ccpp_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
