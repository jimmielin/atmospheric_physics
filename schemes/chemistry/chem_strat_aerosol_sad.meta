[ccpp-table-properties]
  name = chem_strat_aerosol_sad
  type = scheme
  dependencies = chem_mechanism_mod.F90
  dependencies = mozart/mo_sad.F90,mozart/m_sad_data.F90,mozart/mo_strato_rates.F90

[ccpp-arg-table]
  name = chem_strat_aerosol_sad_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pref_mid_norm ]
  standard_name = reference_pressure_in_atmosphere_layer_normalized_by_surface_reference_pressure
  units = 1
  type = real | kind = kind_phys
  dimensions = (vertical_layer_dimension)
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ mwh2o ]
  standard_name = molecular_weight_of_h2o
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ modal_strat_sulfate ]
  standard_name = flag_for_stratospheric_sulfate_treatment
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_strat_aerosol_sad_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pcnst ]
  standard_name = number_of_ccpp_constituents
  units = count
  type = integer
  dimensions = ()
  intent = in
[ temperature ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ mbar ]
  standard_name = mean_wet_atmospheric_mass
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ invariants ]
  standard_name = invariant_number_densities_for_gas_phase_chemistry
  units = molecules cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_invariants)
  intent = in
[ constituents ]
  standard_name = ccpp_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ strato_sad_modal ]
  standard_name = surface_area_density_of_stratospheric_modal_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ cldice ]
  standard_name = cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
  advected = true
[ snow ]
  standard_name = snow_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
  advected = true
[ vmr ]
  standard_name = molar_mixing_ratios_of_gas_phase_species
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_species)
  intent = inout
[ h2ovmr ]
  standard_name = molar_mixing_ratio_of_water_vapor_for_gas_phase_chemistry
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = inout
[ hno3_cond_sts ]
  standard_name = molar_mixing_ratio_of_hno3_condensed_in_supercooled_ternary_solution
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ hno3_cond_nat ]
  standard_name = molar_mixing_ratio_of_hno3_condensed_in_nitric_acid_trihydrate
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ hcl_gas ]
  standard_name = molar_mixing_ratio_of_gas_phase_hcl_for_stratospheric_chemistry
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ hcl_cond ]
  standard_name = molar_mixing_ratio_of_hcl_condensed_in_supercooled_ternary_solution
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ sad_sulfate ]
  standard_name = surface_area_density_of_stratospheric_sulfate_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ sad_nat ]
  standard_name = surface_area_density_of_stratospheric_nitric_acid_trihydrate_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ sad_ice ]
  standard_name = surface_area_density_of_stratospheric_ice_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ radius_sulfate ]
  standard_name = radius_of_stratospheric_sulfate_aerosol
  units = cm
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ radius_nat ]
  standard_name = radius_of_stratospheric_nitric_acid_trihydrate_aerosol
  units = cm
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ radius_ice ]
  standard_name = radius_of_stratospheric_ice_aerosol
  units = cm
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ h2so4m ]
  standard_name = mass_concentration_of_h2so4_in_stratospheric_sulfate_aerosol
  units = ug m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
