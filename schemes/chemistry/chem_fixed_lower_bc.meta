[ccpp-table-properties]
  name = chem_fixed_lower_bc
  type = scheme
  dependencies = chem_mechanism_mod.F90,chem_species_map.F90,chem_interp_utils.F90
  dependencies = mozart/mo_flbc.F90

[ccpp-arg-table]
  name = chem_fixed_lower_bc_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ mpicom ]
  standard_name = mpi_communicator
  units = index
  type = integer
  dimensions = ()
  intent = in
[ mpi_root_id ]
  standard_name = mpi_root
  units = index
  type = integer
  dimensions = ()
  intent = in
[ ncols ]
  standard_name = horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ lat ]
  standard_name = latitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_dimension)
  intent = in
[ lon ]
  standard_name = longitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_dimension)
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ flbc_file ]
  standard_name = filename_of_fixed_lower_boundary_mixing_ratios
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ flbc_list ]
  standard_name = species_with_fixed_lower_boundary_mixing_ratios
  units = none
  type = character | kind = len=*
  dimensions = (flbc_list_dimension)
  intent = in
[ flbc_type ]
  standard_name = time_interpolation_method_for_fixed_lower_boundary_mixing_ratios
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ flbc_cycle_yr ]
  standard_name = cycle_year_for_fixed_lower_boundary_mixing_ratios
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ flbc_fixed_ymd ]
  standard_name = fixed_date_for_fixed_lower_boundary_mixing_ratios
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ flbc_fixed_tod ]
  standard_name = fixed_time_of_day_for_fixed_lower_boundary_mixing_ratios
  units = s
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_fixed_lower_bc_timestep_init
  type = scheme
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_fixed_lower_bc_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ vmr_ws ]
  standard_name = molar_mixing_ratio_of_mam_microphysics_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
