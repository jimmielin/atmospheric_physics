[ccpp-table-properties]
  name = chem_photolysis_table
  type = scheme
  dependencies = chem_mechanism_mod.F90
  dependencies = mozart/mo_photo.F90,mozart/mo_jlong.F90,mozart/mo_jshort.F90,mozart/mo_util.F90
  dependencies = ../radiation_utils/solar_irradiance_data.F90

[ccpp-arg-table]
  name = chem_photolysis_table_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ mpicom ]
  standard_name = mpi_communicator
  units = index
  type = integer
  dimensions = ()
  intent = in
[ mpi_root_id ]
  standard_name = mpi_root
  units = index
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ncols ]
  standard_name = horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ lat ]
  standard_name = latitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_dimension)
  intent = in
[ xs_coef_file ]
  standard_name = filepath_for_o2_schumann_runge_band_cross_section_coefficients
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ xs_short_file ]
  standard_name = filepath_for_short_wavelength_photolysis_cross_sections
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ xs_long_file ]
  standard_name = filepath_for_photolysis_cross_sections
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ rsf_file ]
  standard_name = filepath_for_photolysis_rate_lookup_table
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ exo_coldens_file ]
  standard_name = filepath_for_exospheric_absorber_column_densities
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ photo_max_zen ]
  standard_name = maximum_solar_zenith_angle_for_photolysis
  units = degrees
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ nbins_solar ]
  standard_name = number_of_wavelength_samples_of_spectrum
  units = count
  type = integer
  dimensions = ()
  intent = in
[ wavelength_endpoints ]
  standard_name = wavelength_endpoints
  units = nm
  type = real | kind = kind_phys
  dimensions = (number_of_wavelength_samples_of_spectrum_plus_one)
  intent = in
[ ptop_ref ]
  standard_name = air_pressure_at_top_of_atmosphere_model
  units = Pa
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ num_pr_lev ]
  standard_name = number_of_pure_pressure_levels_at_top
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rearth ]
  standard_name = radius_of_earth
  units = m
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_photolysis_table_timestep_init
  type = scheme
[ calday ]
  standard_name = fractional_calendar_days_on_end_of_current_timestep
  units = days
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ nbins_solar ]
  standard_name = number_of_wavelength_samples_of_spectrum
  units = count
  type = integer
  dimensions = ()
  intent = in
[ wavelength_endpoints ]
  standard_name = wavelength_endpoints
  units = nm
  type = real | kind = kind_phys
  dimensions = (number_of_wavelength_samples_of_spectrum_plus_one)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_photolysis_table_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ temperature ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pint ]
  standard_name = air_pressure_at_interface
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ zm ]
  standard_name = geopotential_height_wrt_surface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ zi ]
  standard_name = geopotential_height_wrt_surface_at_interface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ phis ]
  standard_name = surface_geopotential
  units = m2 s-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ rga ]
  standard_name = reciprocal_of_gravitational_acceleration
  units = s2 m-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ zen_angle ]
  standard_name = solar_zenith_angle
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ srf_alb ]
  standard_name = surface_albedo_due_to_uv_and_vis_direct_from_coupler
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ clouds ]
  standard_name = cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ lwc ]
  standard_name = cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  advected = true
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ esfact ]
  standard_name = earth_sun_distance
  units = AU
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ invariants ]
  standard_name = invariant_number_densities_for_gas_phase_chemistry
  units = molecules cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_invariants)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratios_of_gas_phase_species
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_species)
  intent = in
[ rate ]
  standard_name = reaction_rate_constants_for_gas_phase_chemistry
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_reactions)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
