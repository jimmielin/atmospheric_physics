[ccpp-table-properties]
  name = chem_extfrc
  type = scheme
  dependencies = pp_trop_mozart/chem_mods.F90,mozart/mo_chem_utls.F90,mozart/mo_tracname.F90

########################################################################
# chem_extfrc_init
########################################################################
[ccpp-arg-table]
  name = chem_extfrc_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ ext_frc_specifier ]
  standard_name = specifier_for_chem_external_forcing
  units = none
  type = character | kind = len=*
  dimensions = (ext_frc_specifier_dimension)
  intent = in
[ ext_frc_file ]
  standard_name = filename_for_chem_external_forcing
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ ext_frc_filelist ]
  standard_name = filename_of_file_list_for_chem_external_forcing
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ ext_frc_datapath ]
  standard_name = datapath_for_chem_external_forcing
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ ext_frc_type ]
  standard_name = time_interpolation_method_for_chem_external_forcing
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ ext_frc_cycle_yr ]
  standard_name = cycle_year_for_chem_external_forcing
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ ext_frc_fixed_ymd ]
  standard_name = fixed_date_for_chem_external_forcing
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ ext_frc_fixed_tod ]
  standard_name = fixed_time_of_day_for_chem_external_forcing
  units = s
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

########################################################################
# chem_extfrc_run
########################################################################
[ccpp-arg-table]
  name = chem_extfrc_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pint ]
  standard_name = air_pressure_at_interface
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ phis ]
  standard_name = surface_geopotential
  units = m2 s-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ zi ]
  standard_name = geopotential_height_wrt_surface_at_interface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ extfrc_out ]
  standard_name = chem_external_forcing
  units = molec cm-3 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_chemistry_species)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
