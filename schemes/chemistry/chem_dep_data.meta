[ccpp-table-properties]
  name = chem_dep_data
  type = scheme

[ccpp-arg-table]
  name = chem_dep_data_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ dep_data_file ]
  # gas_deposition_dep_data_file
  standard_name = filename_of_gas_deposition_parameter_dataset
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
