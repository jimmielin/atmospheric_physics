[ccpp-table-properties]
  name = chem_ccmi_tracers
  type = scheme
  dependencies = chem_mechanism_mod.F90

[ccpp-arg-table]
  name = chem_ccmi_tracers_init
  type = scheme
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_ccmi_tracers_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ lat ]
  standard_name = latitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratios_of_gas_phase_species
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_species)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
