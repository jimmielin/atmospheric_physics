<?xml version="1.0"?>

<?xml-stylesheet type="text/xsl"?>

<entry_id_pg version="2.0">

  <entry id="ext_frc_datapath">
    <type>char*256</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>datapath_for_chem_external_forcing</standard_name>
    <units>none</units>
    <desc>
      Full pathname of the directory that contains external forcing data files.
    </desc>
    <values>
      <value>${DIN_LOC_ROOT}/atm/cam/chem/trop_mozart/emis</value>
    </values>
  </entry>

  <entry id="ext_frc_file">
    <type>char*256</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>filename_for_chem_external_forcing</standard_name>
    <units>none</units>
    <desc>
      Filename of dataset for external forcing (alternative to specifier).
    </desc>
    <values>
      <value>UNSET</value>
    </values>
  </entry>

  <entry id="ext_frc_filelist">
    <type>char*256</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>filename_of_file_list_for_chem_external_forcing</standard_name>
    <units>none</units>
    <desc>
      Filename of file that contains a sequence of filenames for external forcing data.
      The filenames in this file are relative to the directory specified by ext_frc_datapath.
    </desc>
    <values>
      <value>UNSET</value>
    </values>
  </entry>

  <entry id="ext_frc_specifier">
    <type>char*256(100)</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>specifier_for_chem_external_forcing</standard_name>
    <units>none</units>
    <desc>
      External forcing file specifiers.
      Format: 'SPECIES -> FILEPATH' or 'SPECIES -> SCALEFACTOR*FILEPATH'
      Example: 'NO -> /path/to/emis_NO.nc'
    </desc>
    <values>
      <value>''</value>
    </values>
  </entry>

  <entry id="ext_frc_type">
    <type>char*32</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>time_interpolation_method_for_chem_external_forcing</standard_name>
    <units>none</units>
    <valid_values>CYCLICAL,SERIAL,INTERP_MISSING_MONTHS,FIXED</valid_values>
    <desc>
      Type of time interpolation for data in external forcing files.
      Can be set to 'CYCLICAL', 'SERIAL', 'INTERP_MISSING_MONTHS', or 'FIXED'.
      Default: 'CYCLICAL'
    </desc>
    <values>
      <value>CYCLICAL</value>
    </values>
  </entry>

  <entry id="ext_frc_cycle_yr">
    <type>integer</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>cycle_year_for_chem_external_forcing</standard_name>
    <units>1</units>
    <desc>
      The cycle year of the external forcing data if ext_frc_type is 'CYCLICAL'.
      Format: YYYY
      Default: 0
    </desc>
    <values>
      <value>0</value>
    </values>
  </entry>

  <entry id="ext_frc_fixed_ymd">
    <type>integer</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>fixed_date_for_chem_external_forcing</standard_name>
    <units>1</units>
    <desc>
      The date at which the external forcing data is fixed if ext_frc_type is 'FIXED'.
      Format: YYYYMMDD
      Default: 0
    </desc>
    <values>
      <value>0</value>
    </values>
  </entry>

  <entry id="ext_frc_fixed_tod">
    <type>integer</type>
    <category>chemistry</category>
    <group>chem_extfrc_nl</group>
    <standard_name>fixed_time_of_day_for_chem_external_forcing</standard_name>
    <units>s</units>
    <desc>
      The time of day (seconds) corresponding to ext_frc_fixed_ymd at which the
      external forcing data is fixed if ext_frc_type is 'FIXED'.
      Default: 0 seconds
    </desc>
    <values>
      <value>0</value>
    </values>
  </entry>

</entry_id_pg>
