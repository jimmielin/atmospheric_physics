[ccpp-table-properties]
  name = chem_o3s_reset
  type = scheme
  dependencies = chem_mechanism_mod.F90

[ccpp-arg-table]
  name = chem_o3s_reset_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ rxn_rate_sums ]
  standard_name = reaction_rate_sum_expressions_for_gas_phase_chemistry
  units = none
  type = character | kind = len=*
  dimensions = (rxn_rate_sums_dimension)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_o3s_reset_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ dt ]
  standard_name = timestep_for_physics
  units = s
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ troplev ]
  standard_name = tropopause_vertical_layer_index
  units = index
  type = integer
  dimensions = (horizontal_loop_extent)
  intent = in
[ rate ]
  standard_name = reaction_rate_constants_for_gas_phase_chemistry
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_reactions)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratios_of_gas_phase_species
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_species)
  intent = inout
[ o3s_loss ]
  standard_name = loss_rate_of_stratospheric_ozone_tracer_due_to_gas_phase_chemistry
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
