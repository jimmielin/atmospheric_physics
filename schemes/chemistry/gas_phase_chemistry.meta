[ccpp-table-properties]
  name = gas_phase_chemistry
  type = scheme
  dependencies = pp_trop_mozart/chem_mods.F90,pp_trop_mozart/mo_sim_dat.F90,mozart/mo_tracname.F90
  dependencies = mozart/mo_chem_utls.F90,mozart/mo_setinv.F90,mozart/mo_mass_xforms.F90
  dependencies = mozart/mo_mean_mass.F90,mozart/mo_negtrc.F90,mozart/mo_constants.F90
  dependencies = pp_trop_mozart/mo_setrxt.F90,pp_trop_mozart/mo_adjrxt.F90
  dependencies = pp_trop_mozart/mo_exp_sol.F90,pp_trop_mozart/mo_imp_sol.F90
  dependencies = pp_trop_mozart/mo_indprd.F90,pp_trop_mozart/mo_prod_loss.F90
  dependencies = pp_trop_mozart/mo_lin_matrix.F90,pp_trop_mozart/mo_nln_matrix.F90
  dependencies = pp_trop_mozart/mo_lu_factor.F90,pp_trop_mozart/mo_lu_solve.F90
  dependencies = pp_trop_mozart/mo_phtadj.F90,pp_trop_mozart/mo_rxt_rates_conv.F90,mozart/mo_jpl.F90
  dependencies = pp_trop_mozart/m_spc_id.F90,pp_trop_mozart/m_rxt_id.F90
  dependencies = mozart/mo_usrrxt_trop.F90,mozart/mo_photo.F90,mozart/mo_jlong.F90,mozart/mo_util.F90
  dependencies = ../../to_be_ccppized/ccpp_chem_utils.F90

########################################################################
# gas_phase_chemistry_register
########################################################################
[ccpp-arg-table]
  name = gas_phase_chemistry_register
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ chemistry_constituents ]
  standard_name = gas_phase_chemistry_constituents
  units = none
  type = ccpp_constituent_properties_t
  allocatable = True
  dimensions = (:)
  intent = out
[ num_gas_phase_chem_species ]
  standard_name = number_of_gas_phase_chemistry_species
  units = count
  type = integer
  dimensions = ()
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

########################################################################
# gas_phase_chemistry_init
########################################################################
[ccpp-arg-table]
  name = gas_phase_chemistry_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ vertical_layer_dimension ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ constituent_props_ptr ]
  standard_name = ccpp_constituent_properties
  units = none
  type = ccpp_constituent_prop_ptr_t
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ rsf_file ]
  standard_name = filepath_for_photolysis_rate_lookup_table
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ xs_long_file ]
  standard_name = filepath_for_photolysis_cross_sections
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ sol_irrad ]
  standard_name = solar_irradiance
  units = W m-2 nm-1
  type = real | kind = kind_phys
  dimensions = (number_of_wavelength_samples_of_spectrum)
  intent = in
[ wavelength_endpoints ]
  standard_name = wavelength_endpoints
  units = nm
  type = real | kind = kind_phys
  dimensions = (number_of_wavelength_samples_of_spectrum_plus_one)
  intent = in
[ nbins_solar ]
  standard_name = number_of_wavelength_samples_of_spectrum
  units = count
  type = integer
  dimensions = ()
  intent = in
[ photo_max_zen ]
  standard_name = maximum_solar_zenith_angle_for_photolysis
  units = degrees
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

########################################################################
# gas_phase_chemistry_run
########################################################################
[ccpp-arg-table]
  name = gas_phase_chemistry_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ dtime ]
  standard_name = timestep_for_physics
  units = s
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ temperature ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pressure_midpoint ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pressure_thickness ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pressure_interface ]
  standard_name = air_pressure_at_interface
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ geopotential_height_wrt_surface ]
  standard_name = geopotential_height_wrt_surface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ geopotential_height_wrt_surface_at_interface ]
  standard_name = geopotential_height_wrt_surface_at_interface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ q_wv ]
  standard_name = water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ constituents ]
  standard_name = ccpp_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ extfrc_in ]
  standard_name = chem_external_forcing
  units = molec cm-3 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_chemistry_species)
  intent = in
[ srf_emis_in ]
  standard_name = chem_surface_emission_flux
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_gas_phase_chemistry_species)
  intent = in
[ zen_angle ]
  standard_name = solar_zenith_angle
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ srf_alb ]
  standard_name = surface_albedo_due_to_uv_and_vis_direct_from_coupler
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ clouds ]
  standard_name = cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ lwc ]
  standard_name = cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ earth_sun_distance ]
  standard_name = earth_sun_distance
  units = AU
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ constituent_tendencies ]
  standard_name = ccpp_constituent_tendencies
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
