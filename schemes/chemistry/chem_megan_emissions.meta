[ccpp-table-properties]
  name = chem_megan_emissions
  type = scheme

[ccpp-arg-table]
  name = chem_megan_emissions_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ megan_nflds ]
  standard_name = number_of_megan_voc_emission_fields
  units = count
  type = integer
  dimensions = ()
  intent = in
[ megan_cflx_species ]
  standard_name = constituent_names_for_megan_voc_emission_fields
  units = none
  type = character | kind = len=*
  dimensions = (megan_cflx_species_dimension)
  intent = in
[ const_props ]
  standard_name = ccpp_constituent_properties
  units = none
  type = ccpp_constituent_prop_ptr_t
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_megan_emissions_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ meganflx ]
  standard_name = surface_upward_megan_voc_emission_fluxes_from_coupler
  units = mole m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_megan_voc_emission_fields)
  intent = in
[ cflx ]
  standard_name = surface_upward_ccpp_constituent_fluxes_from_coupler
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
