[ccpp-table-properties]
  name = chem_mechanism_select
  type = scheme
  dependencies = chem_mechanism_mod.F90,../../to_be_ccppized/ccpp_chem_utils.F90
  dependencies = ../../phys_utils/atmos_phys_string_utils.F90

[ccpp-arg-table]
  name = chem_mechanism_select_init
  type = scheme
[ chem_mechanism ]
  standard_name = gas_phase_chemistry_mechanism_name
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
