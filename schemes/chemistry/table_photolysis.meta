[ccpp-table-properties]
  name = table_photolysis
  type = scheme
  dependencies = pp_trop_mam4/chem_mods.F90,pp_trop_mam4/mo_sim_dat.F90,pp_trop_mam4/mo_phtadj.F90
  dependencies = pp_trop_mam4/m_spc_id.F90,pp_trop_mam4/m_rxt_id.F90
  dependencies = mozart/mo_photo.F90,mozart/mo_jlong.F90,mozart/mo_setinv.F90
  dependencies = mozart/mo_chem_utls.F90,mozart/mo_tracname.F90
  dependencies = mozart/mo_constants.F90,mozart/mo_util.F90

[ccpp-arg-table]
  name = table_photolysis_init
  type = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ mpicom ]
  standard_name = mpi_communicator
  units = index
  type = integer
  dimensions = ()
  intent = in
[ mpi_root_id ]
  standard_name = mpi_root
  units = index
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ xs_long_file ]
  standard_name = filepath_for_photolysis_cross_sections
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ rsf_file ]
  standard_name = filepath_for_photolysis_rate_lookup_table
  units = none
  type = character | kind = len=256
  dimensions = ()
  intent = in
[ photo_max_zen ]
  standard_name = maximum_solar_zenith_angle_for_photolysis
  units = degrees
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ sol_irrad ]
  standard_name = solar_irradiance
  units = W m-2 nm-1
  type = real | kind = kind_phys
  dimensions = (number_of_wavelength_samples_of_spectrum)
  intent = in
[ wavelength_endpoints ]
  standard_name = wavelength_endpoints
  units = nm
  type = real | kind = kind_phys
  dimensions = (number_of_wavelength_samples_of_spectrum_plus_one)
  intent = in
[ nbins_solar ]
  standard_name = number_of_wavelength_samples_of_spectrum
  units = count
  type = integer
  dimensions = ()
  intent = in
[ const_props ]
  standard_name = ccpp_constituent_properties
  units = none
  type = ccpp_constituent_prop_ptr_t
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = table_photolysis_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ temperature ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pressure_midpoint ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pressure_thickness ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ geopotential_height_wrt_surface ]
  standard_name = geopotential_height_wrt_surface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ geopotential_height_wrt_surface_at_interface ]
  standard_name = geopotential_height_wrt_surface_at_interface
  units = m
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = in
[ zen_angle ]
  standard_name = solar_zenith_angle
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ srf_alb ]
  standard_name = surface_albedo_due_to_uv_and_vis_direct_from_coupler
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ clouds ]
  standard_name = cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ lwc ]
  standard_name = cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  advected = true
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ earth_sun_distance ]
  standard_name = earth_sun_distance
  units = AU
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ mwdry ]
  standard_name = molecular_weight_of_dry_air
  units = g mol-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ constituents ]
  standard_name = ccpp_constituents
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ jh2o2 ]
  standard_name = jh2o2
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ jsoa_a1 ]
  standard_name = jsoa_a1
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ jsoa_a2 ]
  standard_name = jsoa_a2
  units = s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
