[ccpp-table-properties]
  name = chem_strat_het_rates
  type = scheme
  dependencies = chem_mechanism_mod.F90
  dependencies = mozart/mo_strato_rates.F90,mozart/mo_sad.F90,mozart/m_sad_data.F90

[ccpp-arg-table]
  name = chem_strat_het_rates_init
  type = scheme
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_strat_het_rates_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ invariants ]
  standard_name = invariant_number_densities_for_gas_phase_chemistry
  units = molecules cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_invariants)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ temperature ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ radius_sulfate ]
  standard_name = radius_of_stratospheric_sulfate_aerosol
  units = cm
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ sad_sulfate ]
  standard_name = surface_area_density_of_stratospheric_sulfate_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ sad_nat ]
  standard_name = surface_area_density_of_stratospheric_nitric_acid_trihydrate_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ sad_ice ]
  standard_name = surface_area_density_of_stratospheric_ice_aerosol
  units = cm2 cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ h2ovmr ]
  standard_name = molar_mixing_ratio_of_water_vapor_for_gas_phase_chemistry
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ hcl_gas ]
  standard_name = molar_mixing_ratio_of_gas_phase_hcl_for_stratospheric_chemistry
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ vmr ]
  standard_name = molar_mixing_ratios_of_gas_phase_species
  units = mol mol-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_species)
  intent = inout
[ rate ]
  standard_name = reaction_rate_constants_for_gas_phase_chemistry
  units = none
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_reactions)
  intent = inout
[ gprob_n2o5 ]
  standard_name = reaction_probability_of_n2o5_on_stratospheric_sulfate_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ gprob_cnt_hcl ]
  standard_name = reaction_probability_of_clono2_with_hcl_on_stratospheric_sulfate_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ gprob_cnt_h2o ]
  standard_name = reaction_probability_of_clono2_with_h2o_on_stratospheric_sulfate_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ gprob_bnt_h2o ]
  standard_name = reaction_probability_of_brono2_with_h2o_on_stratospheric_sulfate_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ gprob_hocl_hcl ]
  standard_name = reaction_probability_of_hocl_with_hcl_on_stratospheric_sulfate_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ gprob_hobr_hcl ]
  standard_name = reaction_probability_of_hobr_with_hcl_on_stratospheric_sulfate_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ wtper ]
  standard_name = weight_percent_of_h2so4_in_stratospheric_sulfate_aerosol
  units = percent
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
