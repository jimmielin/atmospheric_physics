[ccpp-table-properties]
  name = pumas_downstream_exports
  type = scheme
  dependencies = pumas/micro_pumas_diags.F90,pumas/pumas_kinds.F90

[ccpp-arg-table]
  name  = pumas_downstream_exports_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ micro_nlev ]
  standard_name = microphysics_vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ cpair ]
  standard_name = specific_heat_of_dry_air_at_constant_pressure
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ pumas_airT_tend ]
  standard_name = tendency_of_pumas_dry_air_enthalpy_at_constant_pressure
  units = J kg-1 s-1
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ pumas_airq_tend ]
  standard_name = tendency_of_pumas_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1 s-1
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ pumas_cldliq_tend ]
  standard_name = tendency_of_pumas_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1 s-1
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ pumas_cldice_tend ]
  standard_name = tendency_of_pumas_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1 s-1
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ pumas_numliq_tend ]
  standard_name = tendency_of_pumas_mass_number_concentration_of_cloud_liquid_wrt_moist_air_and_condensed_water
  units = kg-1 s-1
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ pumas_numice_tend ]
  standard_name = tendency_of_pumas_mass_number_concentration_of_cloud_ice_wrt_moist_air_and_condensed_water
  units = kg-1 s-1
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ pumas_strat_liq_cldfrc ]
  standard_name = pumas_stratiform_cloud_liquid_area_fraction
  units = fraction
  type = real | kind = pumas_r8
  dimensions = (microphysics_horizontal_loop_extent, microphysics_vertical_layer_dimension)
  intent = in
[ micro_proc_rates ]
  standard_name = microphysics_process_rates
  units = none
  type = proc_rates_type
  dimensions = ()
  intent = in
[ cc_t ]
  standard_name = tendency_of_air_temperature_due_to_microphysics
  units = K s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cc_qv ]
  standard_name = tendency_of_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_microphysics
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cc_ql ]
  standard_name = tendency_of_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_microphysics
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cc_qi ]
  standard_name = tendency_of_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_microphysics
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cc_nl ]
  standard_name = tendency_of_cloud_liquid_water_number_concentration_due_to_microphysics
  units = kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cc_ni ]
  standard_name = tendency_of_cloud_ice_number_concentration_due_to_microphysics
  units = kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cc_qlst ]
  standard_name = tendency_of_incloud_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_microphysics
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ wsedl ]
  standard_name = sedimentation_velocity_of_liquid_stratus_cloud_droplet
  units = m s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
