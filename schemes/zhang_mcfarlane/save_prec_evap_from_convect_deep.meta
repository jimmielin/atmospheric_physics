[ccpp-table-properties]
  name = save_prec_evap_from_convect_deep
  type = scheme

[ccpp-arg-table]
  name = save_prec_evap_from_convect_deep_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ zm_evap_qv_tend ]
  standard_name = tendency_of_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ prec_evap_dp ]
  standard_name = precipitation_evaporation_due_to_deep_convection
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
