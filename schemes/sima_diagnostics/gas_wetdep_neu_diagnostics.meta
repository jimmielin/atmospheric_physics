[ccpp-table-properties]
  name = gas_wetdep_neu_diagnostics
  type = scheme
  dependencies = ../chemistry/gas_wetdep_neu_ccpp.F90

[ccpp-arg-table]
  name = gas_wetdep_neu_diagnostics_init
  type = scheme
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = gas_wetdep_neu_diagnostics_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ dtwr_diag ]
  standard_name = tendency_of_gas_phase_constituents_due_to_wet_removal
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ heff_diag ]
  standard_name = effective_henrys_law_coefficients_of_gas_phase_constituents
  units = M atm-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ wdflx_diag ]
  standard_name = vertically_integrated_wet_deposition_flux_of_gas_phase_constituents
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
