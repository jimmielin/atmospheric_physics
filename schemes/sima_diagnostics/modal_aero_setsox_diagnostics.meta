[ccpp-table-properties]
  name = modal_aero_setsox_diagnostics
  type = scheme
  dependencies = ../modal_aero/ccpp/mam_mode_metadata.F90

[ccpp-arg-table]
  name = modal_aero_setsox_diagnostics_init
  type = scheme
[ const_props ]
  standard_name = ccpp_constituent_properties
  units = none
  type = ccpp_constituent_prop_ptr_t
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = modal_aero_setsox_diagnostics_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ aqso4 ]
  standard_name = column_integrated_aqueous_phase_sulfate_production_of_modal_aerosol
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_aerosol_modes)
  intent = in
[ aqh2so4 ]
  standard_name = column_integrated_aqueous_phase_sulfate_production_from_h2so4_uptake_of_modal_aerosol
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_aerosol_modes)
  intent = in
[ aqso4_h2o2 ]
  standard_name = column_integrated_aqueous_phase_sulfate_production_from_hydrogen_peroxide
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ aqso4_o3 ]
  standard_name = column_integrated_aqueous_phase_sulfate_production_from_ozone
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ xphlwc ]
  standard_name = cloud_ph_multiplied_by_cloud_liquid_water_content
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
