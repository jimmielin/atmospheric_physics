[ccpp-table-properties]
  name = aero_emissions_diagnostics
  type = scheme
  dependencies = ../modal_aero/ccpp/aero_emissions_ccpp.F90

[ccpp-arg-table]
  name = aero_emissions_diagnostics_init
  type = scheme
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = aero_emissions_diagnostics_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ cflx ]
  standard_name = surface_upward_ccpp_constituent_fluxes_from_coupler
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ cflx_dust_diag ]
  standard_name = surface_upward_ccpp_constituent_fluxes_due_to_dust_emissions
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ soil_erod_diag ]
  standard_name = thresholded_soil_erodibility_factor_for_dust_emissions
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
