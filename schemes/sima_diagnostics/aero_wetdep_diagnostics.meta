[ccpp-table-properties]
  name = aero_wetdep_diagnostics
  type = scheme
  dependencies = mam_deposition_diagnostics_utils.F90,../modal_aero/ccpp/mam_mode_metadata.F90

[ccpp-arg-table]
  name = aero_wetdep_diagnostics_init
  type = scheme
[ const_props ]
  standard_name = ccpp_constituent_properties
  units = none
  type = ccpp_constituent_prop_ptr_t
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ convproc_do_aer ]
  standard_name = do_convective_processing_of_aerosols
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ deepconv_wetdep_history ]
  standard_name = do_deep_convective_wet_deposition_history
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = aero_wetdep_diagnostics_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ aerdepwetis ]
  standard_name = surface_wet_deposition_flux_of_interstitial_aerosol_constituents
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ aerdepwetcw ]
  standard_name = surface_wet_deposition_flux_of_cloud_borne_aerosol_constituents
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ dqdt_wetdep ]
  standard_name = tendency_of_aerosol_constituents_due_to_wet_deposition
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ icscavt_diag ]
  standard_name = tendency_of_aerosol_constituents_due_to_convective_in_cloud_scavenging
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ isscavt_diag ]
  standard_name = tendency_of_aerosol_constituents_due_to_stratiform_in_cloud_scavenging
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ bcscavt_diag ]
  standard_name = tendency_of_aerosol_constituents_due_to_convective_below_cloud_scavenging
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ bsscavt_diag ]
  standard_name = tendency_of_aerosol_constituents_due_to_stratiform_below_cloud_scavenging
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ fracis_wetdep ]
  standard_name = insoluble_fraction_of_aerosol_constituents_from_wet_deposition
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent = in
[ sfsic ]
  standard_name = surface_wet_deposition_flux_of_aerosol_constituents_due_to_convective_in_cloud_scavenging
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ sfsis ]
  standard_name = surface_wet_deposition_flux_of_aerosol_constituents_due_to_stratiform_in_cloud_scavenging
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ sfsbc ]
  standard_name = surface_wet_deposition_flux_of_aerosol_constituents_due_to_convective_below_cloud_scavenging
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ sfsbs ]
  standard_name = surface_wet_deposition_flux_of_aerosol_constituents_due_to_stratiform_below_cloud_scavenging
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ sfses ]
  standard_name = surface_wet_deposition_flux_of_aerosol_constituents_due_to_stratiform_precipitation_evaporation_resuspension
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ sol_factb_diag ]
  standard_name = below_cloud_solubility_factor_for_interstitial_aerosol_wet_removal_of_modal_aerosol
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_aerosol_modes)
  intent = in
[ rprddp ]
  standard_name = tendency_of_precipitation_wrt_moist_air_and_condensed_water_due_to_deep_convection_excluding_subcloud_evaporation
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ rprdsh ]
  standard_name = tendency_of_precipitation_wrt_moist_air_and_condensed_water_due_to_shallow_convection_excluding_subcloud_evaporation
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
