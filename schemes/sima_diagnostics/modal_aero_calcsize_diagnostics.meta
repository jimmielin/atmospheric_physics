[ccpp-table-properties]
  name = modal_aero_calcsize_diagnostics
  type = scheme
  dependencies = ../modal_aero/ccpp/mam_mode_metadata.F90

[ccpp-arg-table]
  name = modal_aero_calcsize_diagnostics_init
  type = scheme
[ const_props ]
  standard_name = ccpp_constituent_properties
  units = none
  type = ccpp_constituent_prop_ptr_t
  dimensions = (number_of_ccpp_constituents)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = modal_aero_calcsize_diagnostics_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ qsrflx_csiz1 ]
  standard_name = column_integrated_number_adjustment_source_of_modal_aerosol
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ qsrflx_csiz2 ]
  standard_name = column_integrated_number_adjustment_sink_of_modal_aerosol
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ qsrflx_csiz3 ]
  standard_name = column_integrated_aitken_to_accumulation_transfer_of_modal_aerosol
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ qsrflx_csiz4 ]
  standard_name = column_integrated_accumulation_to_aitken_transfer_of_modal_aerosol
  units = kg m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, number_of_ccpp_constituents)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
