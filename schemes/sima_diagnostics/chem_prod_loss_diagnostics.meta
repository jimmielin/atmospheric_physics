[ccpp-table-properties]
  name = chem_prod_loss_diagnostics
  type = scheme
  dependencies = ../chemistry/chem_mechanism_mod.F90

[ccpp-arg-table]
  name = chem_prod_loss_diagnostics_init
  type = scheme
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name = chem_prod_loss_diagnostics_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ invariants ]
  standard_name = invariant_number_densities_for_gas_phase_chemistry
  units = molecules cm-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_gas_phase_invariants)
  intent = in
[ prod_in ]
  standard_name = gas_phase_chemistry_production_rates
  units = mol mol-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_implicit_gas_phase_species)
  intent = in
[ loss_in ]
  standard_name = gas_phase_chemistry_loss_rates
  units = mol mol-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_implicit_gas_phase_species)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
