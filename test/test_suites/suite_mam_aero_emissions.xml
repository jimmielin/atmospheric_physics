<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_aero_emissions" version="1.0">
  <!--
    Standalone snapshot test suite for MAM mineral dust and sea salt surface
    emissions (aero_emissions_ccpp).

    Note: In snapshot testing without chem_srf_emissions, num_a1 and num_a2
    carry only dust and sea salt number emissions (whereas full-model snapshots
    also accumulate prescribed file number emissions into num_a1 and num_a2).
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>aero_emissions_ccpp</scheme><!-- dropsonde:portable=modal_dust_emissions_run -->
    <scheme>aero_emissions_diagnostics</scheme>
  </group>
</suite>
