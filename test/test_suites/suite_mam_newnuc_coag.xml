<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_newnuc_coag" version="1.0">
  <!--
    Standalone snapshot test suite for MAM new-particle nucleation (newnuc) and
    coagulation (coag). See suite_modal_aero_microphysics.xml for the full VMR
    microphysics cluster architecture.

    Reads the post-rename VMR state (aerochem_vmr_<name>) and H2SO4 change
    inputs (mam_del_h2so4_gasprod, mam_del_h2so4_aeruptk) from the snapshot and
    stages two intermediate VMR verification checkpoints:
      1. mam_vmr_checkpoint_postnewnuc vs. aerochem_vmr_postnewnuc
      2. mam_vmr_checkpoint_postcoag   vs. aerochem_vmr_postcoag
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>sulfur_chemistry_stub</scheme>
    <scheme>mam_mode_metadata</scheme>

    <!-- Init-only: populates pcage aging state read by modal_aero_coag_ccpp_init -->
    <scheme>modal_aero_gasaerexch_setup</scheme>
    <scheme>to_be_ccppized_temporary</scheme>

    <scheme>modal_aero_newnuc_ccpp</scheme><!-- dropsonde:portable=modal_aero_newnuc_run -->
    <scheme>modal_aero_newnuc_diagnostics</scheme>
    <scheme>mam_vmr_checkpoint_postnewnuc</scheme>

    <scheme>modal_aero_coag_ccpp</scheme><!-- dropsonde:portable=modal_aero_coag_run -->
    <scheme>modal_aero_coag_diagnostics</scheme>
    <scheme>mam_vmr_diagnostics</scheme>
    <scheme>mam_vmr_checkpoint_postcoag</scheme>
  </group>
</suite>
