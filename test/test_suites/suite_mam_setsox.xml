<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_setsox" version="1.0">
  <!--
    Standalone snapshot test suite for MAM aqueous sulfur chemistry (setsox).
    See suite_modal_aero_microphysics.xml for the full VMR microphysics cluster
    architecture.

    Because the snapshot's default aerochem_vmr_<name> fields hold the
    post-setsox VMR state, mam_vmr_inject_presetsox rewinds the workspace to
    the pre-setsox capture (aerochem_vmr_presetsox_<name>). Two outputs are
    verified against the snapshot:
      1. Post-setsox working vmr against aerochem_vmr_<name>.
      2. mam_setsox_vmr_tend ((vmr - vmr_entry) / dt) against
         mam_setsox_vmr_tend_<name> (the prior-process tendency consumed by
         modal_aero_rename_ccpp).
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>sulfur_chemistry_stub</scheme>
    <scheme>mam_mode_metadata</scheme>
    <scheme>chem_vmr_metadata</scheme>
    <scheme>chem_mean_mass</scheme>

    <!-- Rewind working vmr to pre-setsox snapshot capture and save entry checkpoint -->
    <scheme>mam_vmr_inject_presetsox</scheme>
    <scheme>chem_vmr_checkpoint_entry</scheme>

    <scheme>chem_dep_data</scheme>
    <scheme>modal_aero_setsox_ccpp</scheme><!-- dropsonde:portable=setsox_sub -->
    <scheme>mam_setsox_tendency</scheme>
    <scheme>modal_aero_setsox_diagnostics</scheme>
    <scheme>mam_vmr_diagnostics</scheme>
  </group>
</suite>
