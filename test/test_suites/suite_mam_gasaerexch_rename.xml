<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_gasaerexch_rename" version="1.0">
  <!--
    Standalone snapshot test suite for MAM gas-aerosol exchange + mode merging
    (rename) + VMR tendency application (mam_vmr_apply). See
    suite_modal_aero_microphysics.xml for the full VMR microphysics cluster
    architecture and Method A / Method B VMR input modes.

    In this standalone sub-suite, setsox is not run; the prior-process aqueous
    chemistry tendency (mam_setsox_vmr_tend, consumed by rename as dqdt_other)
    and post-setsox entry VMR (aerochem_vmr_<name>) are read directly from the
    snapshot.
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>sulfur_chemistry_stub</scheme>
    <scheme>mam_mode_metadata</scheme>
    <scheme>chem_vmr_metadata</scheme>
    <scheme>modal_aero_gasaerexch_setup</scheme>
    <!-- find tropopause for stratospheric sulfate -->
    <scheme>tropopause_find</scheme>
    <scheme>chem_mean_mass</scheme>

    <!-- VMR input source: enable chem_vmr_pack for Method A, or leave commented
         for Method B (reads snapshot aerochem_vmr_<name> directly) -->
    <!-- <scheme>chem_vmr_pack</scheme> -->

    <scheme>chem_vmr_checkpoint_entry</scheme>

    <scheme>modal_aero_gasaerexch_ccpp</scheme>
    <scheme>modal_aero_gasaerexch_diagnostics</scheme>

    <scheme>modal_aero_rename_ccpp</scheme><!-- dropsonde:portable=modal_aero_rename_run -->
    <scheme>modal_aero_rename_diagnostics</scheme>

    <scheme>mam_vmr_apply</scheme>
    <scheme>mam_vmr_diagnostics</scheme>

    <scheme>chem_vmr_unpack</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <!-- Intentionally no qneg: snapshot capture bracket ends prior to qneg -->
  </group>
</suite>
