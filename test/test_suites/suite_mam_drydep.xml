<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_drydep" version="1.0">
  <!--
    Standalone snapshot test suite for MAM aerosol dry deposition and
    gravitational settling (aero_drydep_ccpp) and surface deposition flux
    partitioning (aero_deposition_setdry_ccpp).
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>mam_mode_metadata</scheme>

    <scheme>aero_drydep_ccpp</scheme><!-- dropsonde:portable=dust_sediment_tend -->
    <scheme>aero_drydep_diagnostics</scheme>

    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <!-- Only aerosol constituent tendencies are applied; omit geopotential_temp
         to match CAM (which only updates geopotential when heating or water-species
         tendencies are present). -->
    <scheme>aero_deposition_setdry_ccpp</scheme>
  </group>
</suite>
