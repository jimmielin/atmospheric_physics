<?xml version="1.0" encoding="UTF-8"?>

<suite name="modal_aero_microphysics" version="1.0">
  <!--
    Modal Aerosol Model (MAM4) VMR microphysics cluster test suite:
    aqueous sulfur chemistry (setsox), gas-aerosol exchange (condensation and
    primary-carbon aging), mode merging (rename), new-particle nucleation
    (newnuc), and coagulation (coag).

    All processes in this cluster operate on a shared molar mixing ratio (VMR)
    workspace (vmr) rather than directly on MMR constituents:

      [Method A: chem_vmr_pack (MMR -> vmr)]
        OR
      [Method B: snapshot aerochem_vmr_* + mam_vmr_inject_presetsox]
          |
          v
      chem_vmr_checkpoint_entry (saves vmr_entry)
          |
          v
      modal_aero_setsox_ccpp (updates vmr in place)
          |
          +-> mam_setsox_tendency: dqdt_other = (vmr - vmr_entry) / dt
          |                                         |
          v                                         |
      modal_aero_gasaerexch_ccpp (writes dqdt)      |
          |                                         |
          v                                         v
      modal_aero_rename_ccpp (accumulates onto dqdt using dqdt + dqdt_other)
          |
          v
      mam_vmr_apply (vmr += dqdt * dt; records del_h2so4_aeruptk)
          |
          v
      modal_aero_newnuc_ccpp (updates vmr; consumes del_h2so4_gasprod & _aeruptk)
          |  [mam_vmr_checkpoint_postnewnuc]
          v
      modal_aero_coag_ccpp (updates vmr in place)
          |  [mam_vmr_checkpoint_postcoag]
          v
      chem_vmr_unpack ((vmr - vmr_entry) / dt -> constituent tendencies)
          |
          v
      apply_constituent_tendencies

    VMR input modes (mutually exclusive):
      Method A (production shape): Enable chem_vmr_pack and comment out
        mam_vmr_inject_presetsox to pack MMR constituents into vmr.
        (Note: the snapshot MMR -> VMR round-trip introduces ~1 ULP difference
        relative to CAM's internal VMR array.)
      Method B (bit-for-bit snapshot verification, default below): Comment out
        chem_vmr_pack and enable mam_vmr_inject_presetsox to initialize vmr
        directly from the snapshot's raw aerochem_vmr_presetsox_<name> fields.

    Sub-suites testing individual segments of this cluster:
      - suite_mam_setsox.xml
      - suite_mam_gasaerexch_rename.xml
      - suite_mam_newnuc_coag.xml
      - suite_mam_sulfur_chemistry.xml (adds upstream minimal sulfur chemistry)
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>sulfur_chemistry_stub</scheme>
    <scheme>mam_mode_metadata</scheme>
    <scheme>chem_vmr_metadata</scheme>

    <!-- Init-only: resolves gasaerexch indices and pcage aging state (also read by coag init) -->
    <scheme>modal_aero_gasaerexch_setup</scheme>
    <scheme>to_be_ccppized_temporary</scheme>
    <scheme>tropopause_find</scheme>
    <scheme>chem_mean_mass</scheme>

    <!-- VMR input source: enable chem_vmr_pack for Method A, or
         mam_vmr_inject_presetsox for Method B (see header diagram) -->
    <!-- <scheme>chem_vmr_pack</scheme> -->
    <scheme>mam_vmr_inject_presetsox</scheme>

    <scheme>chem_vmr_checkpoint_entry</scheme>
    <scheme>chem_dep_data</scheme>

    <scheme>modal_aero_setsox_ccpp</scheme><!-- dropsonde:portable=setsox_sub -->
    <scheme>mam_setsox_tendency</scheme>
    <scheme>modal_aero_setsox_diagnostics</scheme>

    <scheme>modal_aero_gasaerexch_ccpp</scheme>
    <scheme>modal_aero_gasaerexch_diagnostics</scheme>

    <scheme>modal_aero_rename_ccpp</scheme><!-- dropsonde:portable=modal_aero_rename_run -->
    <scheme>modal_aero_rename_diagnostics</scheme>

    <scheme>mam_vmr_apply</scheme>

    <scheme>modal_aero_newnuc_ccpp</scheme><!-- dropsonde:portable=modal_aero_newnuc_run -->
    <scheme>modal_aero_newnuc_diagnostics</scheme>
    <!-- Snapshot checkpoint: stages post-newnuc vmr against aerochem_vmr_postnewnuc -->
    <scheme>mam_vmr_checkpoint_postnewnuc</scheme>

    <scheme>modal_aero_coag_ccpp</scheme><!-- dropsonde:portable=modal_aero_coag_run -->
    <scheme>modal_aero_coag_diagnostics</scheme>
    <!-- Snapshot checkpoint: stages post-coag vmr against aerochem_vmr_postcoag -->
    <scheme>mam_vmr_checkpoint_postcoag</scheme>

    <scheme>mam_vmr_diagnostics</scheme>
    <scheme>chem_vmr_unpack</scheme>
    <scheme>apply_constituent_tendencies</scheme>
    <!-- Intentionally no qneg: snapshot capture bracket ends prior to qneg -->
  </group>
</suite>
