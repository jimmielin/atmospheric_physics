<?xml version="1.0" encoding="UTF-8"?>

<!-- Standalone test suite for lookup-table photolysis (table_photolysis:
     j_H2O2, j_SOA_a1, j_SOA_a2). sulfur_chemistry_stub registers the O3
     constituent used for overhead column O3 absorption, and
     solar_irradiance_data (whose init must precede table_photolysis_init)
     initializes the reference solar spectrum. -->

<suite name="mam_table_photolysis" version="1.0">
  <group name="physics_after_coupler">
    <scheme>sulfur_chemistry_stub</scheme>
    <scheme>solar_irradiance_data</scheme>
    <scheme>table_photolysis</scheme>
  </group>
</suite>
