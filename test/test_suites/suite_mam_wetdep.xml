<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_wetdep" version="1.0">
  <!--
    Standalone validation suite for MAM aerosol wet deposition: convective
    processing (aero_convproc: in-updraft transport, activation, wet removal,
    resuspension) followed by stratiform scavenging (wetdepa_v2 via
    aero_wetdep_ccpp).
  -->

  <group name="physics_before_coupler">
    <!-- Register MAM aerosol species (interstitial + cloud-borne) as CCPP
         constituents -->
    <scheme>mam_constituents</scheme>

    <!-- Init-only: mode metadata + species index maps (interstitial and
         cloud-borne constituent maps drive both wetdep schemes) -->
    <scheme>mam_mode_metadata</scheme>

    <!-- Init-only: wv_sat_init (activate_aerosol computes saturation via
         qsat inside convproc's activation) -->
    <scheme>to_be_ccppized_temporary</scheme>

    <!-- Convective processing:
         deep-convective transport, activation, wet removal and resuspension.

         Accumulate interstitial tendencies into the shared constituent tendencies,
         apply evaporated-rain resuspension to cloud-borne constituents in place.

         Only runs when convproc_do_aer=.true. in namelist. -->
    <scheme>aero_convproc_ccpp</scheme><!-- dropsonde:portable=aero_convproc_run -->

    <!-- Stratiform scavenging: wetdepa_v2 over bins x phases,
         update cloud-borne in-place, interstitial tendencies accumulated,
         fracis written -->
    <scheme>aero_wetdep_ccpp</scheme><!-- dropsonde:portable=wetdepa_v2 -->

    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <!-- intentionally no geopotential_temp here since no water species are updated here. -->

    <!-- Surface coupling:
         translate per-constituent wet deposition fluxes into the bulk cam_out coupler fields.
         (CAM equivalent aero_deposition_cam_setwet) -->
    <scheme>aero_deposition_setwet_ccpp</scheme>
  </group>
</suite>
