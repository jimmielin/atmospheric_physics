<?xml version="1.0" encoding="UTF-8"?>

<suite name="mam_wetdep" version="1.0">
  <!--
    Standalone snapshot test suite for MAM aerosol wet deposition: deep
    convective cloud processing (aero_convproc_ccpp) followed by stratiform
    and shallow-convective wet scavenging (aero_wetdep_ccpp) and surface
    deposition flux partitioning (aero_deposition_setwet_ccpp).
  -->

  <group name="physics_before_coupler">
    <scheme>mam_constituents</scheme>
    <scheme>mam_mode_metadata</scheme>
    <scheme>to_be_ccppized_temporary</scheme>

    <!-- Snapshot-only shim: converts real-valued snapshot ZM index fields
         (ZM_IDEEP, ZM_JT, ZM_MAXG) to integer indices for aero_convproc_ccpp -->
    <scheme>deep_convection_indices_from_snapshot</scheme>

    <scheme>aero_convproc_ccpp</scheme><!-- dropsonde:portable=aero_convproc_run -->
    <!-- Must run before aero_wetdep_ccpp so SFWETC records convective-only aerdepwetis -->
    <scheme>aero_convproc_diagnostics</scheme>

    <!-- Stratiform scavenging: wetdepa_v2 over bins x phases,
         update cloud-borne in-place, interstitial tendencies accumulated,
         fracis written -->
    <scheme>aero_wetdep_ccpp</scheme><!-- dropsonde:portable=wetdepa_v2 -->
    <scheme>aero_wetdep_diagnostics</scheme>

    <scheme>apply_constituent_tendencies</scheme>
    <scheme>qneg</scheme>
    <!-- Only aerosol constituent tendencies are applied; omit geopotential_temp
         to match CAM (which only updates geopotential when heating or water-species
         tendencies are present). -->

    <!-- surface coupling -->
    <scheme>aero_deposition_setwet_ccpp</scheme>
  </group>
</suite>
